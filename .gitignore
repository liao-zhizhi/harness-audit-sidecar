# Build and packaging output
build/
dist/
.pypi-build/
*.egg-info/
*.whl
# (scripts/publish_pypi.sh builds into .pypi-build/ on purpose: `dist/`
#  survives across renames and whole minor series, and uploading it is
#  how a stale wheel ships under a version nobody is looking at.)

# Python bytecode
__pycache__/
*.py[cod]

# Local audit traces produced by running the sidecar
audit_trace.jsonl
# Persisted inflammation counters, written beside the trace by default. This is
# runtime state, not source: committing it would ship one machine's suspicion
# to everyone else's first run.
.immune_state.json
.immune-*.tmp

# ...but the curated sample kept for documentation must stay tracked.
# A bare filename pattern above matches at any depth, so this negation is
# what keeps examples/sample_trace.jsonl in the repository even if the
# ignore rule is later widened (for example to *.jsonl).
!examples/sample_trace.jsonl
.coverage

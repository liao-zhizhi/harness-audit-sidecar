# Files shipped in the sdist beyond what setuptools finds automatically.
# The wheel intentionally contains only `audit_sidecar/`; the sdist carries the
# docs and tests so that `pip download --no-binary :all:` yields a buildable,
# inspectable source tree.
include LICENSE
include README.md
include ERRATA.md
recursive-include examples *
# The default judgment base. It is package data (so it reaches the wheel) and
# also belongs in the sdist, where a source install must find it.
recursive-include audit_sidecar/rules *.yaml *.yml
recursive-include tests *.py
